# Cloudflare Pages. Copied to dist/ by Vite.
# Entry points and the service worker must revalidate so a new release is picked up promptly.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/registerSW.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Hashed build output never changes under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
