# Google Cloud OAuth client (Web application) - public by nature but kept out of the repo
VITE_GOOGLE_CLIENT_ID=
# Browser API key restricted to the Picker API and your site's HTTP referrer
VITE_GOOGLE_API_KEY=
# Google Cloud project number (Picker app id)
VITE_GOOGLE_PROJECT_NUMBER=

# Public template copy link; override in a fork
VITE_TEMPLATE_COPY_URL=https://docs.google.com/spreadsheets/d/1ISaC0GTqkYlwsnrUd9IU2wrFjmWYx-jUfcqgaTLp8yY/copy
